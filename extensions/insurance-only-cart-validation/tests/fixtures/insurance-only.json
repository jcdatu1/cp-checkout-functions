{
  "payload": {
    "export": "cart-validations-generate-run",
    "target": "cart.validations.generate.run",
    "input": {
      "cart": {
        "lines": [
          {
            "merchandise": {
              "__typename": "ProductVariant",
              "product": { "productType": "Insurance" }
            }
          }
        ]
      }
    },
    "output": {
      "operations": [
        {
          "validationAdd": {
            "errors": [
              {
                "message": "Your cart contains only shipping protection. Please add a product to continue.",
                "target": "$.cart"
              }
            ]
          }
        }
      ]
    }
  }
}
